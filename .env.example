# Copy to .env.local for local development. Never commit real values.

# URL of the deployed Cloudflare Worker chatbot proxy (see worker/README.md).
# Leave unset to keep the chatbot widget in its graceful "not configured" state.
REACT_APP_CHATBOT_API_URL=

# Optional — only needed once a live Sanity project exists (see cms/README.md).
# Used by scripts/fetch-cms-content.js, not by the React app directly.
SANITY_PROJECT_ID=
SANITY_DATASET=production
