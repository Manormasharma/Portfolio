# Copy to .env.local for local development. Never commit real values.

# Chat backend URL. Production builds get it from .env.production; for local
# dev put REACT_APP_CHAT_API_URL=http://localhost:8787/api/chat in
# .env.development.local and run `npm run dev:api`.
REACT_APP_CHAT_API_URL=

# Used by the local dev API server (server.js -> api/chat.js) only.
CHAT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional — only needed once a live Sanity project exists (see cms/README.md).
# Used by scripts/fetch-cms-content.js, not by the React app directly.
SANITY_PROJECT_ID=
SANITY_DATASET=production
